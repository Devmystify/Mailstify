<div class="flex justify-between items-center mb-6">
  <h2 class="text-3xl font-bold text-gray-800">Campaign Drafts</h2>
</div>

<div class="bg-white shadow-md rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Target List</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @campaigns.each do |campaign| %>
        <tr class="hover:bg-gray-50">
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= campaign.name %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= campaign.subject %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= campaign.list.name %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-orange-600">Draft</td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
            <%= link_to "Preview", campaign, class: "text-blue-600 hover:text-blue-900" %>
            <%= link_to "Edit", edit_campaign_path(campaign), class: "text-yellow-600 hover:text-yellow-900" %>
            <%= link_to "Delete", campaign, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-900" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
